# Copie este arquivo para ".env" e preencha. Nunca envie o .env para o Git.
# Gere a SECRET_KEY com: python -c "import secrets; print(secrets.token_urlsafe(50))"

# ---- Produção (servidor com domínio e HTTPS) ----
DEBUG=0
HTTPS=1
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DOMINIO=portal.suaempresa.com.br
ALLOWED_HOSTS=portal.suaempresa.com.br
CSRF_TRUSTED_ORIGINS=https://portal.suaempresa.com.br

# ---- Teste local com Docker (descomente e comente o bloco de produção acima) ----
# DEBUG=0
# HTTPS=0
# SECRET_KEY=chave-de-teste-local
# DOMINIO=http://localhost
# ALLOWED_HOSTS=localhost
# CSRF_TRUSTED_ORIGINS=http://localhost

# ---- Banco (o host "db" já é definido pelo docker-compose) ----
DB_NAME=portal
DB_USER=portal
DB_PASSWORD=troque-esta-senha

# ---- E-mail (recuperação de senha). Em branco, os e-mails vão para o log. ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=rh@suaempresa.com.br
